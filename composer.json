{
	"name": "detain/myadmin-ksplice-licensing",
	"type": "myadmin-plugin",
	"description": "Ksplice Licensing Class",
	"keywords": [
		"ksplice",
		"administration",
		"license"
	],
	"license": "LGPL-2.1-only",
	"authors": [
		{
			"name": "Joe Huss",
			"homepage": "https://my.interserver.net/"
		}
	],
	"config": {
		"bin-dir": "vendor/bin"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "pear/net_url",
				"version": "trunk",
				"source": {
					"url": "https://github.com/pear/Net_URL.git",
					"type": "git",
					"reference": "trunk"
				}
			}
		}
	],
	"require": {
		"php": ">=5.0.0",
		"old_pear/http_request": "dev-trunk",
		"pear/net_url": "dev-trunk",
		"symfony/event-dispatcher": "*@stable",
		"detain/myadmin-plugin-installer": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Detain\\MyAdminKsplice\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Detain\\MyAdminKsplice\\Tests\\": "tests/"
		}
	}
}
